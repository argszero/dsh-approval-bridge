{
  "name": "@argszero/dsh-approval-bridge",
  "description": "Lets a plugin answer approval requests. The harness dispatches `approval/request` as a scope-filtered waterfall whose first listener is its own browser forwarder, so a plugin registered after it is never reached and a plugin mounted below an agent scope is filtered out with no log. This plugin registers one untagged, prepended listener, exposes register() for answerers, and arbitrates the registered answerers against the host chain - first outcome in the closed vocabulary wins, abstentions and late answers are dropped, and with no answerer registered it is byte-for-byte the next() it replaced. Modes bridge/observe/off, a report tool that answers the admission question the harness does not log, and zero runtime dependencies of its own.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argszero/dsh-approval-bridge.git"
  },
  "homepage": "https://github.com/argszero/dsh-approval-bridge#readme",
  "bugs": {
    "url": "https://github.com/argszero/dsh-approval-bridge/issues"
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "approval",
    "approval-request",
    "waterfall",
    "scope",
    "answerer",
    "bridge"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5 || >=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-scope": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-alpha.2 <0.1.4 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-alpha.1 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-alpha.2 <0.1.4 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-alpha.1 <0.2.2",
    "@deepseek-ai/dsh-user-approval": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-alpha.2 <0.1.4 || >=0.1.5-alpha.1 <0.1.6 || >=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-alpha.1 <0.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.7-rc.1",
    "@types/node": "^24.19.1",
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "probe:seam": "node scripts/probe-seam.mjs",
    "test:inject": "node scripts/inject-defects.mjs",
    "test:probe-lines": "node scripts/probe-lines.mjs",
    "prepublishOnly": "tsc"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
